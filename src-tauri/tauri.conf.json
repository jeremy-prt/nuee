{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuee",
  "version": "0.1.0",
  "identifier": "io.github.jeremy-prt.nuee",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nuée",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "theme": "Dark",
        "backgroundColor": "#171717",
        "visible": false,
        "devtools": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**",
          "$APPDATA/backgrounds/**"
        ]
      },
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "./icons/dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 170,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 200
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQTFDQkIxQTNDRUZDREUKUldUZS9NNmpzY3VobWlsbFVYRWh1R0hsSlRzaGllaUZiMGFEQ0JIdlBLM2Q0cUFEa2YvUnJFSW0K",
      "endpoints": [
        "https://github.com/jeremy-prt/nuee/releases/latest/download/latest.json"
      ]
    }
  }
}
